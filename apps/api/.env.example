NODE_ENV=development
PORT=3000

# Docker Compose: postgresql://laundry:laundry@localhost:5432/laundry?schema=public
DATABASE_URL="postgresql://laundry@127.0.0.1:5432/laundry?schema=public"

# Minimal 32 karakter. Tidak ada nilai default — wajib diisi.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Akun owner pertama, dipakai oleh prisma:seed
SEED_OWNER_EMAIL=owner@laundry.id
SEED_OWNER_PASSWORD=

APP_TIMEZONE=Asia/Jakarta
